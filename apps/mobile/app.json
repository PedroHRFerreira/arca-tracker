{
  "expo": {
    "name": "ARCA Tracker",
    "slug": "arca-tracker",
    "owner": "pedrohrferreira",
    "version": "0.5.0",
    "orientation": "portrait",
    "scheme": "arcatracker",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pedro.arcatracker",
      "infoPlist": {
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing"
        ]
      }
    },
    "android": {
      "package": "com.pedro.arcatracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/arca-cover.png",
        "backgroundColor": "#F7F8F2"
      }
    },
    "plugins": [
      "./plugins/with-bank-visibility.cjs",
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/arca-cover.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8798be59-54af-44a9-af90-3488d6ace355"
      }
    },
    "icon": "./assets/arca-cover.png",
    "web": {
      "favicon": "./assets/arca-cover.png"
    }
  }
}
